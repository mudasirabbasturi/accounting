APP_NAME="Enterprise Accounting & Inventory"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_SECRET=replace_with_a_secure_random_key_here

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=accounts
